# Port dashboardu
APP_PORT=8080

# Opcjonalny prywatny fragment URL webhooka. Zostaw pusty, aby aplikacja
# wygenerowała bezpieczny token przy pierwszym starcie i zapisała go w wolumenie.
WEBHOOK_TOKEN=

# Maksymalny rozmiar importowanego pliku CSV
MAX_UPLOAD_MB=20

# Backupy powstają automatycznie po imporcie i są trzymane w tym samym wolumenie
BACKUP_KEEP=14
MAX_BACKUP_MB=100

TZ=Europe/Warsaw
